{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "vals":                         "0.47.0",
    "go-task":                      "3.53.1",
    "git":                          "2.56.0",
    "upcloud-cli":                  "3.37.0",
    "openstackclient":              "10.5.0",
    "gh":                           "2.103.3",
    "asciinema":                    "3.2.1",
    "cargo-nextest":                "0.9.146",
    "rustc":                        "1.99.0",
    "cargo":                        "1.99.0",
    "clippy":                       "1.99.0",
    "mold":                         "3.0.0",
    "rustfmt":                      "1.99.0",
    "path:gcloud#google-cloud-sdk": "",
    "asciinema-agg":                "1.9.0",
    "ffmpeg":                       "9.0.2",
    "jq":                           "1.8.2",
    "curl":                         "8.22.0",
    "ripgrep":                      "15.2.0",
    "python314Packages.pyte":       "0.8.2",
    "github:NixOS/nixpkgs/nixos-26.05#nodejs_26": {
      "disable_plugin": true
    },
    "pnpm":                       "12.9.0",
    "netlify-cli":                "23.15.0",
    "pkg-config":                 "0.29.2",
    "path:tauri-deps#tauri-deps": ""
  },
  "env": {
    "PKG_CONFIG_PATH": "$PWD/.devbox/nix/profile/default/lib/pkgconfig"
  },
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.local/bin:$PATH\"",
      "[ -n \"$DAD_DEV_BIN\" ] && export PATH=\"$DAD_DEV_BIN:$PATH\" || true",
      "[ -n \"$USE_VALS\" ] && [ -z \"$GOOGLE_APPLICATION_CREDENTIALS\" ] && [ -f \"$HOME/.config/gcloud/dot-agent-deck-secrets.json\" ] && export GOOGLE_APPLICATION_CREDENTIALS=\"$HOME/.config/gcloud/dot-agent-deck-secrets.json\" || true",
      "[ -n \"$USE_VALS\" ] && { _dad_otel_endpoint=\"$OTEL_EXPORTER_OTLP_ENDPOINT\"; eval \"$(vals env -export -f .env.vals.yaml)\"; [ -n \"$_dad_otel_endpoint\" ] && export OTEL_EXPORTER_OTLP_ENDPOINT=\"$_dad_otel_endpoint\"; unset _dad_otel_endpoint; } || true",
      "[ -n \"$HONEYCOMB_INGEST_KEY\" ] && case \"$OTEL_EXPORTER_OTLP_ENDPOINT\" in https://api.honeycomb.io|https://api.honeycomb.io/*|https://api.eu1.honeycomb.io|https://api.eu1.honeycomb.io/*) [ -z \"$OTEL_EXPORTER_OTLP_HEADERS\" ] && export OTEL_EXPORTER_OTLP_HEADERS=\"x-honeycomb-team=$HONEYCOMB_INGEST_KEY\" ;; *) [ \"$OTEL_EXPORTER_OTLP_HEADERS\" = \"x-honeycomb-team=$HONEYCOMB_INGEST_KEY\" ] && unset OTEL_EXPORTER_OTLP_HEADERS ;; esac || true",
      "[ -f .env ] && source .env || true"
    ],
    "scripts": {
      "agent":              ["claude"],
      "agent-plan":         ["claude --model opus --permission-mode plan"],
      "agent-small":        ["claude --model haiku"],
      "agent-big":          ["claude --model opus"],
      "agent-orchestrator": ["claude --model opus"],
      "agent-orchestrator-oc": ["opencode --model openai/gpt-6.1-sol"],
      "agent-coder":        ["claude --model opus"],
      "agent-coder-oc":     ["opencode --model openai/gpt-6.1-sol"],
      "agent-reviewer":     ["claude --model opus"],
      "agent-reviewer-oc":  ["opencode --model openai/gpt-6.1-sol"],
      "agent-auditor":      ["claude --model opus"],
      "agent-auditor-oc":   ["opencode --model openai/gpt-6.1-sol"],
      "agent-tester":       ["claude --model opus"],
      "agent-tester-oc":    ["opencode --model openai/gpt-6.1-sol"],
      "agent-release":      ["claude --model sonnet"],
      "pi-big":             ["pi --model anthropic/claude-opus-4-8 --thinking high --approve"],
      "pi-sol":             ["pi --provider openai-codex --model gpt-6.1-sol --thinking high --approve"],
      "oc-big":             ["opencode --model openai/gpt-6.1-sol"],
      "oc-release":         ["opencode --model openai/gpt-6.1-sol"],
      "oc-kimi":            ["opencode --model openrouter/moonshotai/kimi-k2.6"],
      "codex-big": [
        "\"$DEVBOX_PROJECT_ROOT/scripts/box/require-codex-version.sh\"",
        "codex --model gpt-6.1-sol --sandbox danger-full-access --ask-for-approval never -c model_reasoning_effort=high -c check_for_update_on_startup=false"
      ]
    }
  }
}
