{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "vals":                         "0.46.0",
    "go-task":                      "3.53.1",
    "git":                          "2.55.0",
    "upcloud-cli":                  "3.36.0",
    "gh":                           "2.98.0",
    "asciinema":                    "3.2.1",
    "cargo-nextest":                "0.9.143",
    "rustc":                        "1.97.1",
    "cargo":                        "1.97.1",
    "clippy":                       "1.97.1",
    "mold":                         "2.42.0",
    "rustfmt":                      "1.97.1",
    "path:gcloud#google-cloud-sdk": "",
    "asciinema-agg":                "1.9.0",
    "ffmpeg":                       "9.0.1",
    "jq":                           "1.8.2",
    "curl":                         "8.17.0",
    "ripgrep":                      "15.2.0",
    "python314Packages.pyte":       "0.8.2",
    "nodejs": {
      "version":        "24.12.0",
      "disable_plugin": true
    },
    "pnpm":                       "11.22.0",
    "pkg-config":                 "0.29.2",
    "path:tauri-deps#tauri-deps": ""
  },
  "env": {
    "PKG_CONFIG_PATH": "$PWD/.devbox/nix/profile/default/lib/pkgconfig"
  },
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.local/bin:$PATH\"",
      "[ -n \"$DAD_DEV_BIN\" ] && export PATH=\"$DAD_DEV_BIN:$PATH\" || true",
      "[ -n \"$USE_VALS\" ] && [ -z \"$GOOGLE_APPLICATION_CREDENTIALS\" ] && [ -f \"$HOME/.config/gcloud/dot-agent-deck-secrets.json\" ] && export GOOGLE_APPLICATION_CREDENTIALS=\"$HOME/.config/gcloud/dot-agent-deck-secrets.json\" || true",
      "[ -n \"$USE_VALS\" ] && eval \"$(vals env -export -f .env.vals.yaml)\" || true",
      "[ -f .env ] && source .env || true"
    ],
    "scripts": {
      "agent":              ["claude"],
      "agent-plan":         ["claude --model opus --permission-mode plan"],
      "agent-small":        ["claude --model haiku"],
      "agent-big":          ["claude --model opus"],
      "agent-orchestrator": ["claude --model opus"],
      "agent-orchestrator-oc": ["opencode --model openai/gpt-5.6-sol"],
      "agent-coder":        ["claude --model opus"],
      "agent-coder-oc":     ["opencode --model openai/gpt-5.6-sol"],
      "agent-reviewer":     ["claude --model opus"],
      "agent-reviewer-oc":  ["opencode --model openai/gpt-5.5"],
      "agent-auditor":      ["claude --model opus"],
      "agent-auditor-oc":   ["opencode --model openai/gpt-5.5"],
      "agent-tester":       ["claude --model opus"],
      "agent-tester-oc":    ["opencode --model openai/gpt-5.6-sol"],
      "agent-release":      ["claude --model sonnet"],
      "agent-orchestrator-astra":      ["opencode --model openai/gpt-6-astra"],
      "agent-coder-astra":             ["opencode --model openai/gpt-6-astra"],
      "agent-reviewer-astra":          ["opencode --model openai/gpt-6-astra"],
      "agent-auditor-astra":           ["opencode --model openai/gpt-6-astra"],
      "agent-tester-astra":            ["opencode --model openai/gpt-6-astra"],
      "agent-release-astra":           ["opencode --model openai/gpt-6-astra"],
      "agent-orchestrator-fable":      ["opencode --model anthropic/claude-fable-5-1"],
      "agent-coder-fable":             ["opencode --model anthropic/claude-fable-5-1"],
      "agent-reviewer-fable":          ["opencode --model anthropic/claude-fable-5-1"],
      "agent-auditor-fable":           ["opencode --model anthropic/claude-fable-5-1"],
      "agent-tester-fable":            ["opencode --model anthropic/claude-fable-5-1"],
      "agent-release-fable":           ["opencode --model anthropic/claude-fable-5-1"],
      "agent-orchestrator-kimi":       ["opencode --model moonshotai/kimi-k3"],
      "agent-coder-kimi":              ["opencode --model moonshotai/kimi-k3"],
      "agent-reviewer-kimi":           ["opencode --model moonshotai/kimi-k3"],
      "agent-auditor-kimi":            ["opencode --model moonshotai/kimi-k3"],
      "agent-tester-kimi":             ["opencode --model moonshotai/kimi-k3"],
      "agent-release-kimi":            ["opencode --model moonshotai/kimi-k3"],
      "agent-orchestrator-glm":        ["opencode --model zai/glm-5.3"],
      "agent-coder-glm":               ["opencode --model zai/glm-5.3"],
      "agent-reviewer-glm":            ["opencode --model zai/glm-5.3"],
      "agent-auditor-glm":             ["opencode --model zai/glm-5.3"],
      "agent-tester-glm":              ["opencode --model zai/glm-5.3"],
      "agent-release-glm":             ["opencode --model zai/glm-5.3"],
      "pi-big":             ["pi --model anthropic/claude-opus-4-8 --thinking high --approve"],
      "pi-sol":             ["pi --provider openai --model gpt-5.6-sol --thinking xhigh --approve"],
      "oc-big":             ["opencode --model openai/gpt-5.6-sol"],
      "oc-release":         ["opencode --model openai/gpt-5.4-mini"],
      "oc-kimi":            ["opencode --model openrouter/moonshotai/kimi-k2.6"],
      "codex-big": [
        "codex --model gpt-5.6-sol --sandbox danger-full-access --ask-for-approval never -c model_reasoning_effort=xhigh"
      ]
    }
  }
}
