/target
/desktop/src-tauri/binaries/
# Generated by release.yml's desktop-bundle job (and by bundling locally): the
# real version is merged into the bundle overlay at build time so that no
# tracked file ever carries a version number. PRD #740 Decision 3.
/desktop/src-tauri/tauri.release.conf.json
/dist-desktop/
tmp/

# `nix build` drops a `result` symlink (or `result-<output>` for a named
# output) in the directory it was run from, which for the root flake is the
# repo root. Anchored with a leading slash so a legitimately-named `result`
# elsewhere in the tree is still tracked.
/result
/result-*
# Per-clone dev state — orchestrator IPC, regenerated recordings,
# regenerated test docs. Never committed; regenerated by running
# tests + `cargo xtask docs --tests` locally.
.dot-agent-deck/
.claude/scheduled_tasks.lock

# Documentation site
site/node_modules/
site/build/
site/.docusaurus/

# Demo-reel build artifacts (regenerated each build; reel lives on YouTube)
/reel.mp4
/manifest*.json

# dot-ai skills lock (transient, like scheduled_tasks.lock above)
.dot-ai.lock
