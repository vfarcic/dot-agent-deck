{
  "name": "dot-agent-deck-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "sidecar:prepare": "sh ./scripts/prepare-sidecar.sh release",
    "sidecar:prepare:debug": "sh ./scripts/prepare-sidecar.sh debug",
    "daemon:sync": "sh ./scripts/sync-daemon.sh",
    "pretauri": "sh ./scripts/sync-daemon.sh",
    "bundle:app": "tauri build --config src-tauri/tauri.bundle.conf.json --bundles app",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.27.7",
    "jsdom": "^29.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
