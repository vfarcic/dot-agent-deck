{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh"
    }
  },
  "mcp": {
    "coderabbitai": {
      "type": "local",
      "command": ["npx", "coderabbitai-mcp@latest"],
      "environment": {
        "GITHUB_PAT": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  },
  "permission": {
    "webfetch": "allow",
    "websearch": "allow"
  }
}
